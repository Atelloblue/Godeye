# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENSKY_USERNAME and OPENSKY_PASSWORD (Optional):
# For higher rate limits with the OpenSky Network ADS-B transponder API.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# TOMTOM_API_KEY (Optional):
# Get a free API key at https://developer.tomtom.com (2,500 free requests/day).
# If omitted or invalid, the app automatically falls back to live open street traffic overlays.
TOMTOM_API_KEY=

# CESIUM_ACCESS_TOKEN: Required for 3D Tilesets and premium globe data.
VITE_CESIUM_ACCESS_TOKEN=

